  "routines": [
    {
      "name": "BTCK_CREATE_USER",
      "type": "PROCEDURE",
      "body": "BEGIN\r\n  IF p_full_name IS NULL OR TRIM(p_full_name) = '' THEN\r\n    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Full name is required';\r\n  END IF;\r\n\r\n  IF p_email IS NULL OR TRIM(p_email) = '' THEN\r\n    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Email is required';\r\n  END IF;\r\n\r\n  IF p_password_hash IS NULL OR TRIM(p_password_hash) = '' THEN\r\n    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Password hash is required';\r\n  END IF;\r\n\r\n  INSERT INTO users (full_name, email, password_hash)\r\n  VALUES (TRIM(p_full_name), TRIM(p_email), p_password_hash);\r\n\r\n  SELECT LAST_INSERT_ID() AS user_id;\r\nEND",
      "sql_mode": "NO_ZERO_IN_DATE,NO_ZERO_DATE,NO_ENGINE_SUBSTITUTION",
      "security_type": "DEFINER"
    },
    {
      "name": "BTCK_GET_USER_BY_EMAIL",
      "type": "PROCEDURE",
      "body": "BEGIN\r\n  SELECT user_id, role_code, full_name, email, password_hash\r\n  FROM users\r\n  WHERE email = p_email\r\n  LIMIT 1;\r\nEND",
      "sql_mode": "NO_ZERO_IN_DATE,NO_ZERO_DATE,NO_ENGINE_SUBSTITUTION",
      "security_type": "DEFINER"
    },
    {
      "name": "BTCK_UPDATE_USER_PROFILE",
      "type": "PROCEDURE",
      "body": "BEGIN\r\n  IF p_full_name IS NULL OR TRIM(p_full_name) = '' THEN\r\n    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Full name is required';\r\n  END IF;\r\n\r\n  IF p_email IS NULL OR TRIM(p_email) = '' THEN\r\n    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Email is required';\r\n  END IF;\r\n\r\n  UPDATE users\r\n  SET full_name = TRIM(p_full_name),\r\n      email = TRIM(p_email)\r\n  WHERE user_id = p_user_id;\r\n\r\n  SELECT ROW_COUNT() AS affected_rows;\r\nEND",
      "sql_mode": "NO_ZERO_IN_DATE,NO_ZERO_DATE,NO_ENGINE_SUBSTITUTION",
      "security_type": "DEFINER"
    },
    {
      "name": "CT_LIST_ACTIVE_CATEGORIES",
      "type": "PROCEDURE",
      "body": "BEGIN\r\n    SELECT \r\n        category_id, \r\n        name\r\n    FROM categories\r\n    WHERE is_active = TRUE\r\n    ORDER BY name ASC;\r\nEND",
      "sql_mode": "NO_ZERO_IN_DATE,NO_ZERO_DATE,NO_ENGINE_SUBSTITUTION",
      "security_type": "DEFINER"
    },
    {
      "name": "CT_SEARCH_APPROVED_PLACES",
      "type": "PROCEDURE",
      "body": "BEGIN\r\n    SELECT\r\n        p.place_id,\r\n        p.title,\r\n        p.description,\r\n        p.address,\r\n        p.latitude,\r\n        p.longitude,\r\n        p.category_id,\r\n        c.name AS category_name,\r\n        p.district_id,\r\n        d.district_name,\r\n        d.city_name,\r\n        p.status_code,\r\n        p.created_at\r\n    FROM places AS p\r\n    INNER JOIN categories AS c ON c.category_id = p.category_id\r\n    LEFT JOIN districts AS d ON d.district_id = p.district_id\r\n    INNER JOIN place_statuses AS ps ON ps.status_code = p.status_code\r\n    WHERE ps.is_public = TRUE            -- Đảm bảo trạng thái thuộc diện được hiển thị công khai\r\n      AND c.is_active = TRUE             -- Ẩn địa điểm nếu danh mục cha bị vô hiệu hóa\r\n      AND (\r\n          p_keyword IS NULL \r\n          OR TRIM(p_keyword) = ''\r\n          OR p.title LIKE CONCAT('%', TRIM(p_keyword), '%')\r\n          OR p.description LIKE CONCAT('%', TRIM(p_keyword), '%')\r\n          OR p.address LIKE CONCAT('%', TRIM(p_keyword), '%')\r\n      )\r\n      AND (p_category_id IS NULL OR p.category_id = p_category_id)\r\n      AND (p_district_id IS NULL OR p.district_id = p_district_id)\r\n    ORDER BY p.created_at DESC;\r\nEND",
      "sql_mode": "NO_ZERO_IN_DATE,NO_ZERO_DATE,NO_ENGINE_SUBSTITUTION",
      "security_type": "DEFINER"
    },
    {
      "name": "CT_UPDATE_PLACE_STATUS",
      "type": "PROCEDURE",
      "body": "BEGIN\r\n    -- 1. Kiểm tra quyền Admin của tài khoản thực hiện\r\n    IF NOT EXISTS (\r\n        SELECT 1 \r\n        FROM users \r\n        WHERE user_id = p_admin_user_id \r\n          AND role_code = 'ADMIN'\r\n    ) THEN\r\n        SIGNAL SQLSTATE '45000' \r\n            SET MESSAGE_TEXT = 'Lỗi: Yêu cầu quyền quản trị viên (Admin permission required)';\r\n    END IF;\r\n\r\n    -- 2. Kiểm tra địa điểm cần cập nhật có tồn tại không\r\n    IF NOT EXISTS (\r\n        SELECT 1 \r\n        FROM places \r\n        WHERE place_id = p_place_id\r\n    ) THEN\r\n        SIGNAL SQLSTATE '45000' \r\n            SET MESSAGE_TEXT = 'Lỗi: Không tìm thấy địa điểm (Place not found)';\r\n    END IF;\r\n\r\n    -- 3. Kiểm tra mã trạng thái hợp lệ dựa trên dữ liệu bảng place_statuses\r\n    IF NOT EXISTS (\r\n        SELECT 1 \r\n        FROM place_statuses \r\n        WHERE status_code = p_status_code\r\n    ) THEN\r\n        SIGNAL SQLSTATE '45000' \r\n            SET MESSAGE_TEXT = 'Lỗi: Mã trạng thái không hợp lệ (Invalid place status)';\r\n    END IF;\r\n\r\n    -- 4. Cập nhật trạng thái và làm mới thời gian chỉnh sửa\r\n    UPDATE places\r\n    SET \r\n        status_code = p_status_code,\r\n        updated_at = NOW()\r\n    WHERE place_id = p_place_id;\r\n\r\n    -- 5. Trả về kết quả thực thi\r\n    SELECT ROW_COUNT() AS affected_rows;\r\nEND",
      "sql_mode": "NO_ZERO_IN_DATE,NO_ZERO_DATE,NO_ENGINE_SUBSTITUTION",
      "security_type": "DEFINER"
    },
    {
      "name": "NDHT_HIDE_REVIEW",
      "type": "PROCEDURE",
      "body": "BEGIN\r\n  IF NOT EXISTS (\r\n    SELECT 1\r\n    FROM users\r\n    WHERE user_id = p_admin_user_id\r\n      AND role_code = 'ADMIN'\r\n  ) THEN\r\n    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Admin permission required';\r\n  END IF;\r\n\r\n  UPDATE reviews\r\n  SET status_code = 'HIDDEN'\r\n  WHERE review_id = p_review_id;\r\n\r\n  SELECT ROW_COUNT() AS affected_rows;\r\nEND",
      "sql_mode": "NO_ZERO_IN_DATE,NO_ZERO_DATE,NO_ENGINE_SUBSTITUTION",
      "security_type": "DEFINER"
    },
    {
      "name": "NDHT_LIST_MY_REVIEWED_PLACES",
      "type": "PROCEDURE",
      "body": "BEGIN\r\n  SELECT\r\n    p.place_id,\r\n    p.title,\r\n    p.address,\r\n    r.rating,\r\n    r.content,\r\n    r.status_code AS review_status,\r\n    r.created_at AS reviewed_at\r\n  FROM reviews AS r\r\n  INNER JOIN places AS p ON p.place_id = r.place_id\r\n  WHERE r.user_id = p_user_id\r\n  ORDER BY r.created_at DESC;\r\nEND",
      "sql_mode": "NO_ZERO_IN_DATE,NO_ZERO_DATE,NO_ENGINE_SUBSTITUTION",
      "security_type": "DEFINER"
    },
    {
      "name": "NDHT_SAVE_OR_UPDATE_REVIEW",
      "type": "PROCEDURE",
      "body": "BEGIN\r\n  IF p_rating IS NULL OR p_rating NOT BETWEEN 1 AND 5 THEN\r\n    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Rating must be between 1 and 5';\r\n  END IF;\r\n\r\n  IF NOT EXISTS (\r\n    SELECT 1\r\n    FROM places\r\n    WHERE place_id = p_place_id\r\n      AND status_code = 'APPROVED'\r\n  ) THEN\r\n    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Only approved places can be reviewed';\r\n  END IF;\r\n\r\n  IF EXISTS (\r\n    SELECT 1\r\n    FROM reviews\r\n    WHERE user_id = p_user_id\r\n      AND place_id = p_place_id\r\n  ) THEN\r\n    UPDATE reviews\r\n    SET rating = p_rating,\r\n        content = p_content\r\n    WHERE user_id = p_user_id\r\n      AND place_id = p_place_id;\r\n  ELSE\r\n    INSERT INTO reviews (user_id, place_id, status_code, rating, content)\r\n    VALUES (p_user_id, p_place_id, 'VISIBLE', p_rating, p_content);\r\n  END IF;\r\n\r\n  SELECT 'OK' AS result;\r\nEND",
      "sql_mode": "NO_ZERO_IN_DATE,NO_ZERO_DATE,NO_ENGINE_SUBSTITUTION",
      "security_type": "DEFINER"
    },
    {
      "name": "NPT_ADD_PLACE_IMAGE",
      "type": "PROCEDURE",
      "body": "BEGIN\r\n  IF p_sort_order IS NULL OR p_sort_order NOT BETWEEN 1 AND 3 THEN\r\n    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Image order must be between 1 and 3';\r\n  END IF;\r\n\r\n  IF EXISTS (\r\n    SELECT 1\r\n    FROM place_images\r\n    WHERE place_id = p_place_id\r\n      AND sort_order = p_sort_order\r\n  ) THEN\r\n    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Image slot is already used';\r\n  END IF;\r\n\r\n  INSERT INTO place_images (place_id, image_path, sort_order)\r\n  VALUES (p_place_id, p_image_path, p_sort_order);\r\n\r\n  SELECT LAST_INSERT_ID() AS image_id;\r\nEND",
      "sql_mode": "NO_ZERO_IN_DATE,NO_ZERO_DATE,NO_ENGINE_SUBSTITUTION",
      "security_type": "DEFINER"
    },
    {
      "name": "NPT_SET_FAVORITE",
      "type": "PROCEDURE",
      "body": "BEGIN\r\n  IF p_action = 'ADD' THEN\r\n    IF NOT EXISTS (\r\n      SELECT 1\r\n      FROM places\r\n      WHERE place_id = p_place_id\r\n        AND status_code = 'APPROVED'\r\n    ) THEN\r\n      SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Only approved places can be favorited';\r\n    END IF;\r\n\r\n    IF NOT EXISTS (\r\n      SELECT 1\r\n      FROM favorites\r\n      WHERE user_id = p_user_id\r\n        AND place_id = p_place_id\r\n    ) THEN\r\n      INSERT INTO favorites (user_id, place_id)\r\n      VALUES (p_user_id, p_place_id);\r\n    END IF;\r\n  ELSEIF p_action = 'REMOVE' THEN\r\n    DELETE FROM favorites\r\n    WHERE user_id = p_user_id\r\n      AND place_id = p_place_id;\r\n  ELSE\r\n    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Action must be ADD or REMOVE';\r\n  END IF;\r\n\r\n  SELECT 'OK' AS result;\r\nEND",
      "sql_mode": "NO_ZERO_IN_DATE,NO_ZERO_DATE,NO_ENGINE_SUBSTITUTION",
      "security_type": "DEFINER"
    },
    {
      "name": "NPT_SUBMIT_PLACE",
      "type": "PROCEDURE",
      "body": "BEGIN\r\n  IF p_title IS NULL OR TRIM(p_title) = '' THEN\r\n    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Place title is required';\r\n  END IF;\r\n\r\n  IF p_address IS NULL OR TRIM(p_address) = '' THEN\r\n    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Place address is required';\r\n  END IF;\r\n\r\n  IF p_description IS NULL THEN\r\n    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Place description is required';\r\n  END IF;\r\n\r\n  INSERT INTO places (\r\n    owner_id, category_id, district_id, status_code,\r\n    title, description, address, latitude, longitude\r\n  )\r\n  VALUES (\r\n    p_owner_id, p_category_id, p_district_id, 'PENDING',\r\n    TRIM(p_title), p_description, TRIM(p_address), p_latitude, p_longitude\r\n  );\r\n\r\n  SELECT LAST_INSERT_ID() AS place_id;\r\nEND",
      "sql_mode": "NO_ZERO_IN_DATE,NO_ZERO_DATE,NO_ENGINE_SUBSTITUTION",
      "security_type": "DEFINER"
    }
  ],
