erDiagram
    ROLES ||--o{ USERS : grants
    USERS ||--o{ PLACES : owns
    CATEGORIES ||--o{ PLACES : classifies
    PROVINCES ||--o{ WARDS : contains
    PROVINCES ||--o{ PLACES : has
    WARDS o|--o{ PLACES : optional_ward
    PLACE_STATUSES ||--o{ PLACES : governs
    PLACES ||--|{ PLACE_IMAGES : has_on_submission
    PLACES ||--o{ PLACE_TAGS : tagged
    TAGS ||--o{ PLACE_TAGS : used
    USERS ||--o{ REVIEWS : writes
    PLACES ||--o{ REVIEWS : receives
    REVIEW_STATUSES ||--o{ REVIEWS : governs
    USERS ||--o{ FAVORITES : adds
    PLACES ||--o{ FAVORITES : saved

    ROLES {
        varchar role_code PK
        varchar role_name
    }
    USERS {
        bigint user_id PK
        varchar role_code FK
        varchar full_name
        varchar email UK
        varchar password_hash
        datetime created_at
        datetime updated_at
    }
    CATEGORIES {
        int category_id PK
        varchar name UK
        boolean is_active
    }
    PROVINCES {
        varchar province_code PK
        varchar province_name
        boolean is_active
    }
    WARDS {
        varchar ward_code PK
        varchar province_code FK
        varchar ward_name
        varchar ward_type
        boolean is_active
    }
    PLACE_STATUSES {
        varchar status_code PK
        boolean is_public
    }
    PLACES {
        bigint place_id PK
        bigint owner_id FK
        int category_id FK
        varchar province_code FK
        varchar ward_code FK
        varchar status_code FK
        varchar title
        text description
        varchar address
        decimal latitude
        decimal longitude
        text rejection_reason
        datetime created_at
        datetime updated_at
    }
    PLACE_IMAGES {
        bigint image_id PK
        bigint place_id FK
        varchar image_path
        tinyint sort_order
    }
    TAGS {
        int tag_id PK
        varchar name
        varchar slug UK
        boolean is_active
    }
    PLACE_TAGS {
        bigint place_id PK,FK
        int tag_id PK,FK
    }
    REVIEW_STATUSES {
        varchar status_code PK
        boolean is_public
    }
    REVIEWS {
        bigint review_id PK
        bigint user_id FK
        bigint place_id FK
        varchar status_code FK
        tinyint rating
        text content
        datetime created_at
        datetime updated_at
    }
    FAVORITES {
        bigint user_id PK,FK
        bigint place_id PK,FK
        datetime created_at
    }
